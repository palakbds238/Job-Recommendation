# ── Security ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@jobrec.com
ADMIN_PASSWORD=choose-a-strong-password
COOKIE_SECURE=1                # set to 1 when served over HTTPS

# ── Storage ─────────────────────────────────────────────────
# DATABASE_PATH=job_recommender.db
# UPLOAD_FOLDER=uploads

# ── Blockchain ──────────────────────────────────────────────
# local (default): simulated in-memory chain, zero setup (dev / demo)
# remote         : real EVM network such as Sepolia testnet
# off            : disable the blockchain features
BLOCKCHAIN_MODE=local
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/<key>     (remote only)
# ISSUER_PRIVATE_KEY=0x...        a TESTNET-only key, never a real-money wallet
# CONTRACT_ADDRESS=0x...          leave empty once to deploy, then paste the address

# ── ML ──────────────────────────────────────────────────────
USE_EMBEDDINGS=auto            # auto | 1 | 0

# ── Live job data (optional) ────────────────────────────────
# Adzuna: free key from https://developer.adzuna.com  (India = "in")
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
# ADZUNA_PAGES=1              # pages per query
# ADZUNA_PER_PAGE=20
# ADZUNA_MAX_CALLS=10         # hard cap on API calls per sync (protects your free quota)
# ADZUNA_MAX_DAYS_OLD=30
# Remotive needs no key (remote jobs only; max ~4 fetches/day — the app enforces a 6 h gap)
# LIVE_QUERIES=python developer, data analyst, software engineer
# LIVE_JOB_TTL_DAYS=21        # listings not seen for this long are removed
# LIVE_MAX_JOBS=2000
# CONTACT_EMAIL=you@example.com

# ── Site / account emails ───────────────────────────────────
# CONTACT_EMAIL=support@yourdomain.com     shown on the FAQ & contact page
# PUBLIC_BASE_URL=https://careers.example.org   REQUIRED in production: password-reset links are built from it
#                                          (otherwise they use the request's Host header, which can be spoofed)
# SMTP_HOST=smtp.gmail.com                 without SMTP_HOST no email is sent; the reset link is written to the server log
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=CareerAI <you@gmail.com>
# SMTP_TLS=1                               1 = STARTTLS (default), 0 = none;  SMTP_SSL=1 for port 465
# DEV_SHOW_RESET_LINK=1                    development only: show the reset link on screen when SMTP is not set
